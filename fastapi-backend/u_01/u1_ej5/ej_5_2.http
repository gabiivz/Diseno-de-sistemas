curl -X 'POST' \
  'http://127.0.0.1:8000/items/' \
  -H 'accept: application/json' \
  -H 'Content-Type: application/json' \
  -d '{
  "name": "laptop",
  "description": "una compu potente",
  "price": 1200.50,
  "tax": 120.00
}'
###
curl -X 'PUT' \
  'http://127.0.0.1:8000/items/1' \
  -H 'accept: application/json' \
  -H 'Content-Type: application/json' \
  -d '{
  "name": "laptop pro",
  "description": "actualizada",
  "price": 1500.50,
  "tax": 150.00
}'
###
curl -X 'PUT' \
  'http://127.0.0.1:8000/items/2' \
  -H 'accept: application/json' \
  -H 'Content-Type: application/json' \
  -d '{
  "name": "Monitor",
  "description": "27 pulgadas",
  "price": 300.50,
  "tax": 30.00
}'